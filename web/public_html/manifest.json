{
    "id": "/",
    "name": "DomainCheckr",
    "short_name": "DomainCheckr",
    "description": "Free domain name checker and WHOIS and RDAP lookup tool. Check domain registration, availability, DNS records, expiry dates, and registrar information.",
    "start_url": "/",
    "scope": "/",
    "display": "standalone",
    "display_override": ["window-controls-overlay", "standalone"],
    "orientation": "any",
    "lang": "en",
    "dir": "ltr",
    "background_color": "#ffffff",
    "theme_color": "#0d6efd",
    "categories": ["utilities", "productivity", "security"],
    "prefer_related_applications": false,
    "launch_handler": {
        "client_mode": "navigate-existing"
    },
    "handle_links": "preferred",
    "edge_side_panel": {
        "preferred_width": 420
    },
    "protocol_handlers": [
        {
            "protocol": "web+whois",
            "url": "/?domain=%s"
        }
    ],
    "icons": [
        {
            "src": "assets/images/favicon.svg",
            "sizes": "any",
            "type": "image/svg+xml",
            "purpose": "any"
        },
        {
            "src": "assets/images/favicon.png",
            "sizes": "512x512",
            "type": "image/png",
            "purpose": "any"
        },
        {
            "src": "assets/images/favicon.png",
            "sizes": "512x512",
            "type": "image/png",
            "purpose": "maskable"
        },
        {
            "src": "assets/images/favicon.ico",
            "sizes": "48x48",
            "type": "image/x-icon"
        }
    ],
    "shortcuts": [
        {
            "name": "Single Lookup",
            "short_name": "Lookup",
            "description": "Look up a single domain",
            "url": "/",
            "icons": [{ "src": "assets/images/favicon.png", "sizes": "96x96", "type": "image/png" }]
        },
        {
            "name": "Bulk Lookup",
            "short_name": "Bulk",
            "description": "Look up multiple domains at once",
            "url": "/?mode=bulk",
            "icons": [{ "src": "assets/images/favicon.png", "sizes": "96x96", "type": "image/png" }]
        },
        {
            "name": "Domain Portfolio",
            "short_name": "Portfolio",
            "description": "View your watched domains",
            "url": "/portfolio",
            "icons": [{ "src": "assets/images/favicon.png", "sizes": "96x96", "type": "image/png" }]
        },
        {
            "name": "API Documentation",
            "short_name": "API Docs",
            "description": "View the API documentation",
            "url": "/docs",
            "icons": [{ "src": "assets/images/favicon.png", "sizes": "96x96", "type": "image/png" }]
        }
    ]
}
