# OS files
.DS_Store
Thumbs.db

# IDE
.vscode/
.idea/

# Node
node_modules/
npm-debug.log*

# Environment
.env
.env.*
!.env.example

# Build
dist/
build/

# PHP / Composer
vendor/
composer.lock
.phpunit.cache/

# Auto-generated TLD data (fetched at runtime)
tlds.txt
tld_metadata.json
second_level_suffixes.txt
suffix_list_metadata.json
public_suffix_list.dat

# Self-hosted Swagger UI assets are committed on purpose (the general `vendor/`
# rule above targets Composer's root vendor/ dir). /docs serves these locally so
# the API docs work on shared hosting with no CDN. Re-include the directory
# first, then its contents (a file cannot be re-included if its parent is ignored).
!web/public_html_beta/assets/vendor/
!web/public_html_beta/assets/vendor/**
!web/public_html/assets/vendor/
!web/public_html/assets/vendor/**
